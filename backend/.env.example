SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_SECRET_KEY=
FRONTEND_URL=http://localhost:3000
PORT=3001
BACKEND_PORT=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional queue name for isolated environments; defaults to campaigns.
CAMPAIGNS_QUEUE_NAME=
# Exact proxy source IPs; configure the frontend container IP in deployment.
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# Server-only OpenAI-compatible base URL (e.g. http://localhost:1234/v1).
# A full /chat/completions URL also works. Key may be empty only on localhost.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Default 60000; clamped to 5000–120000 milliseconds.
AI_TIMEOUT_MS=

# Embedding base URL defaults to AI_API_URL; a full /embeddings URL also works.
AI_EMBED_API_URL=
# Embedding key defaults to AI_API_KEY; may be empty only on localhost.
AI_EMBED_API_KEY=
# Required to enable vectors; production target: text-embedding-3-small.
AI_EMBED_MODEL=
# Default 1024; sent to api.openai.com only.
AI_EMBED_DIMENSIONS=
# Retrieval defaults: minimum cosine 0.35, relative gap 0.15, no-answer 0.30, top 5.
AI_RAG_MIN_SCORE=
AI_RAG_RELATIVE_GAP=
AI_RAG_NO_ANSWER_SCORE=
AI_RAG_TOP_K=
# Optional isolated queue name; defaults to kb-index.
KB_QUEUE_NAME=

# Server-only telephony configuration, shared with the calling worker.
TELEPHONY_PROVIDER=
TELEPHONY_API_URL=
TELEPHONY_API_KEY=
TELEPHONY_CALLER_ID=
TELEPHONY_WEBHOOK_SECRET=
CRON_SECRET=
# Defaults to 2; maximum 2.
TELEPHONY_MAX_CONCURRENCY=
# Absolute callback base URL of this application.
APP_PUBLIC_URL=
# CRON_SECRET must contain at least 32 characters.

# Optional isolated calls queue name; defaults to calls.
CALLS_QUEUE_NAME=
