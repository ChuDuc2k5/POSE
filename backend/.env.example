SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_SECRET_KEY=
FRONTEND_URL=http://localhost:3000
PORT=3001
BACKEND_PORT=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Exact proxy source IPs; configure the frontend container IP in deployment.
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# Stable random secret (at least 32 characters) for Google PKCE transaction cookies.
# Generate locally; Google Client Secret belongs in Supabase's Google provider settings.
GOOGLE_OAUTH_STATE_SECRET=
