NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth and catalog queries use the publishable key, server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: private property-file delivery to Guests after a current RLS check.
# Server-only Supabase secret key (or legacy service_role). See SETUP-M02.md.
# Never add NEXT_PUBLIC_ to this variable or commit an actual key.
SUPABASE_STORAGE_SECRET_KEY=
