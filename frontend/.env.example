NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth and catalog queries use the publishable key, server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: private property-file delivery to Guests after a current RLS check.
# Server-only Supabase secret key (or legacy service_role). See SETUP-M02.md.
# Never add NEXT_PUBLIC_ to this variable or commit an actual key.
SUPABASE_STORAGE_SECRET_KEY=

# Server-only OpenAI-compatible base URL (e.g. http://localhost:1234/v1).
# A full /chat/completions URL also works. Key may be empty only on localhost.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Default 60000; clamped to 5000–120000 milliseconds.
AI_TIMEOUT_MS=
SUPABASE_SECRET_KEY=
